{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-bob.example/schema/work-packet-0.1.0-poc.json",
  "title": "Team Bob Work Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["Profile Version", "Task ID", "Difficulty", "Risk", "Customer", "ReqIDs", "Word Baseline", "QA Baseline", "Spec Baseline", "Bazaar Root", "Bazaar Branch", "Bazaar Full Revision ID", "Allowed Files", "Forbidden Areas", "RT Impact", "Safety Impact", "Board Impact", "Driver Impact", "ABI Impact", "Build Impact", "Customer Branch Impact", "RT Impact Clear", "Safety Impact Clear", "Board Impact Clear", "Driver Impact Clear", "ABI Impact Clear", "Build Impact Clear", "Customer Branch Impact Clear", "Clean Working Copy", "Open QA", "Build Profile ID", "Autonomous-Edit-Build-Approved", "Soft-Execute-Risk-Accepted", "Max-Repair-Cycles", "Specification Approver", "Implementation Approver"],
  "properties": {
    "Profile Version": {"const": "0.1.0-poc"}, "Task ID": {"type": "string", "minLength": 1}, "Difficulty": {"type": "string", "minLength": 1}, "Risk": {"enum": ["Green", "Amber", "Red"]}, "Customer": {"type": "string", "minLength": 1},
    "ReqIDs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "Word Baseline": {"type": "string", "minLength": 1}, "QA Baseline": {"type": "string", "minLength": 1}, "Spec Baseline": {"type": "string", "minLength": 1},
    "Bazaar Root": {"type": "string", "minLength": 1}, "Bazaar Branch": {"type": "string", "minLength": 1}, "Bazaar Full Revision ID": {"type": "string", "minLength": 1},
    "Allowed Files": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "Forbidden Areas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "RT Impact": {"type": "string"}, "Safety Impact": {"type": "string"}, "Board Impact": {"type": "string"}, "Driver Impact": {"type": "string"}, "ABI Impact": {"type": "string"}, "Build Impact": {"type": "string"}, "Customer Branch Impact": {"type": "string"},
    "RT Impact Clear": {"enum": ["YES", "NO"]}, "Safety Impact Clear": {"enum": ["YES", "NO"]}, "Board Impact Clear": {"enum": ["YES", "NO"]}, "Driver Impact Clear": {"enum": ["YES", "NO"]}, "ABI Impact Clear": {"enum": ["YES", "NO"]}, "Build Impact Clear": {"enum": ["YES", "NO"]}, "Customer Branch Impact Clear": {"enum": ["YES", "NO"]}, "Clean Working Copy": {"enum": ["YES", "NO"]},
    "Open QA": {"type": "array", "items": {"type": "string"}}, "Build Profile ID": {"type": "string", "minLength": 1}, "Autonomous-Edit-Build-Approved": {"const": "YES"}, "Soft-Execute-Risk-Accepted": {"const": "YES"}, "Max-Repair-Cycles": {"const": 2}, "Specification Approver": {"type": "string", "minLength": 1}, "Implementation Approver": {"type": "string", "minLength": 1}
  },
  "allOf": [{
    "if": {"properties": {"Risk": {"const": "Green"}}},
    "then": {"properties": {
      "Open QA": {"maxItems": 0}, "RT Impact Clear": {"const": "YES"}, "Safety Impact Clear": {"const": "YES"}, "Board Impact Clear": {"const": "YES"}, "Driver Impact Clear": {"const": "YES"}, "ABI Impact Clear": {"const": "YES"}, "Build Impact Clear": {"const": "YES"}, "Customer Branch Impact Clear": {"const": "YES"}, "Clean Working Copy": {"const": "YES"}
    }}
  }]
}
