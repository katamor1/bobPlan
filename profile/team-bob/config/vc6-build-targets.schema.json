{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-bob.example/schema/vc6-build-targets-0.1.0-poc.json",
  "title": "Team Bob VC6 Build Targets",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enabled", "projectFile", "target", "timeoutSeconds", "expectedArtifacts", "excludePatterns", "outputLogPattern", "successPattern", "compilerErrorPattern", "linkerErrorPattern", "environmentErrorPattern", "qualification"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "enabled": {"type": "boolean"},
        "projectFile": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.(?:dsw|dsp)$"},
        "target": {"type": "string", "minLength": 1}, "timeoutSeconds": {"type": "integer", "minimum": 1},
        "expectedArtifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "excludePatterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outputLogPattern": {"type": "string", "minLength": 1}, "successPattern": {"type": "string", "minLength": 1}, "compilerErrorPattern": {"type": "string", "minLength": 1}, "linkerErrorPattern": {"type": "string", "minLength": 1}, "environmentErrorPattern": {"type": "string", "minLength": 1},
        "qualification": {"type": "object", "additionalProperties": false, "required": ["msdevHelp", "makeSucceeded", "rebuildSucceeded", "compileFailureObserved", "linkFailureObserved", "pcId", "recordId", "recordedAt"], "properties": {
          "msdevHelp": {"type": "boolean"}, "makeSucceeded": {"type": "boolean"}, "rebuildSucceeded": {"type": "boolean"}, "compileFailureObserved": {"type": "boolean"}, "linkFailureObserved": {"type": "boolean"},
          "pcId": {"type": "string", "minLength": 1}, "recordId": {"type": "string", "minLength": 1}, "recordedAt": {"type": "string", "minLength": 1}
        }}
      }
    }}
  }
}
