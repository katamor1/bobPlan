{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://team-bob.local/schemas/compliance-result.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","policyVersion","taskId","phase","evaluatedAtUtc","status","workPacketSha256","policyBundleSha256","roleLedgerSha256","artifactSha256","prerequisiteResultSha256","checks"],
  "properties":{
    "schemaVersion":{"type":"string","const":"1.0"},"policyVersion":{"type":"string","const":"0.2.0-poc"},"taskId":{"type":"string","minLength":1},"phase":{"type":"string","enum":["requirements","specification","impact","implementation","review","test"]},"evaluatedAtUtc":{"type":"string","pattern":"Z$"},"status":{"type":"string","enum":["PASS","FAIL","UNRESOLVED"]},"workPacketSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policyBundleSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"roleLedgerSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"artifactSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"prerequisiteResultSha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","evidence","rationale"],"properties":{"id":{"type":"string","pattern":"^[A-Z]+-[MAH]-[0-9]{3}$"},"status":{"type":"string","enum":["PASS","FAIL","NOT_APPLICABLE","NEEDS_HUMAN_REVIEW"]},"evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"type":"string","enum":["path","line","sha256","rationale","command","approvalRecord","resultHash"]},"value":{"type":"string","minLength":1}}}},"rationale":{"type":"string","minLength":1}}}}
  }
}
