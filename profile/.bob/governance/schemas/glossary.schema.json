{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://team-bob.local/schemas/glossary.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["policyVersion","terms"],
  "properties":{
    "policyVersion":{"type":"string","const":"0.2.0-poc"},
    "terms":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","canonical","definition","aliases","forbidden","ownerRole","status","replacementTermId"],"properties":{"id":{"type":"string","pattern":"^TERM-[A-Z0-9-]+$"},"canonical":{"type":"string","minLength":1},"definition":{"type":"string","minLength":1},"aliases":{"type":"array","items":{"type":"string","minLength":1}},"forbidden":{"type":"array","items":{"type":"string","minLength":1}},"ownerRole":{"type":"string","enum":["SPECIFICATION_APPROVER","IMPLEMENTATION_APPROVER","INDEPENDENT_REVIEWER"]},"status":{"type":"string","enum":["ACTIVE","DEPRECATED"]},"replacementTermId":{"enum":[null,"TERM-WORK-PACKET","TERM-REQID","TERM-IMMUTABLE-SOURCE-ANCHOR","TERM-REQUIREMENT-LEDGER","TERM-WORD-BASELINE","TERM-QA-BASELINE","TERM-SPEC-BASELINE","TERM-ALLOWED-FILES","TERM-FORBIDDEN-AREAS","TERM-OPEN-QA","TERM-GREEN","TERM-QUALIFICATION","TERM-MAKE","TERM-REBUILD","TERM-READY-FOR-HUMAN-REVIEW","TERM-SUCCEEDED","TERM-CODE-FAILED-RETRYABLE","TERM-CODE-FAILED-STOP","TERM-ENVIRONMENT-FAILED","TERM-TIMED-OUT","TERM-INTEGRITY-FAILED","TERM-SPECIFICATION-APPROVER","TERM-IMPLEMENTATION-APPROVER","TERM-INDEPENDENT-REVIEWER","TERM-ACTUAL-MACHINE","TERM-CONTROL-NETWORK","TERM-MAINLINE","TERM-SECRETS"]}}}}
  }
}
