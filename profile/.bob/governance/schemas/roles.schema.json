{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://team-bob.local/schemas/roles.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["policyVersion","assignments"],
  "properties":{
    "policyVersion":{"type":"string","const":"0.2.0-poc"},
    "assignments":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","role","principalId","scope","status","validFromUtc","expiresAtUtc"],"properties":{"id":{"type":"string","pattern":"^ASSIGN-[A-Z0-9-]+$"},"role":{"type":"string","enum":["SPECIFICATION_APPROVER","IMPLEMENTATION_APPROVER","INDEPENDENT_REVIEWER"]},"principalId":{"type":"string","minLength":1},"scope":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"status":{"type":"string","enum":["ACTIVE","INACTIVE"]},"validFromUtc":{"type":"string","pattern":"Z$"},"expiresAtUtc":{"type":"string","pattern":"Z$"}}}}
  }
}
