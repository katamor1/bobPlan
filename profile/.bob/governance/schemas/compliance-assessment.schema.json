{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://team-bob.local/schemas/compliance-assessment.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","profileVersion","policyVersion","taskId","phase","workPacketSha256","policyBundleSha256","roleLedgerSha256","artifactPath","artifactSha256","checks"],
  "properties":{
    "schemaVersion":{"type":"string","const":"1.0"},"profileVersion":{"type":"string","const":"0.2.0-poc"},"policyVersion":{"type":"string","const":"0.2.0-poc"},"taskId":{"type":"string","minLength":1},"phase":{"type":"string","enum":["requirements","specification","impact","implementation","review","test"]},
    "workPacketSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policyBundleSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"roleLedgerSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"artifactPath":{"type":"string","minLength":1},"artifactSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status","evidence","message"],"properties":{"id":{"type":"string","pattern":"^[A-Z]+-A-[0-9]{3}$"},"status":{"type":"string","enum":["PASS","FAIL","NOT_APPLICABLE","NEEDS_HUMAN_REVIEW"]},"evidence":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type","value"],"properties":{"type":{"type":"string","enum":["path","line","sha256","rationale","command","approvalRecord","resultHash"]},"value":{"type":"string","minLength":1}}}},"message":{"type":"string","minLength":1}}}}
  }
}
